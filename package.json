{
  "name": "braiins-widget-server",
  "version": "1.0.0",
  "description": "Widget server for BraiinsDeck devices - generates PNG/JPG images from HTML/CSS/JS on-demand",
  "type": "module",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "tsc",
    "start": "node dist/server.js",
    "type-check": "tsc --noEmit"
  },
  "keywords": [
    "braiinsdeck",
    "widget",
    "satori",
    "image-generator",
    "server"
  ],
  "author": "",
  "license": "MIT",
  "dependencies": {
    "@fastify/static": "^7.0.1",
    "dotenv": "^17.2.3",
    "esbuild": "^0.27.2",
    "fastify": "^5.1.0",
    "html-react-parser": "^5.1.19",
    "node-cache": "^5.1.2",
    "satori": "^0.11.2",
    "sharp": "^0.33.5",
    "yaml": "^2.6.1"
  },
  "devDependencies": {
    "@types/node": "^22.10.2",
    "tsx": "^4.19.2",
    "typescript": "^5.7.2"
  }
}
