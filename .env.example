# Widget server auth token (optional)
WIDGET_AUTH_TOKEN=your-token-here

# OpenWeatherMap API key (optional, pro reálná data)
# Get it at: https://openweathermap.org/api
OPENWEATHER_API_KEY=your-key-here

# Home Assistant integration
# HA_HOST: URL of your Home Assistant instance (e.g., http://homeassistant.local:8123)
# HA_TOKEN: Long-lived access token from Home Assistant
HA_HOST=http://homeassistant.local:8123
HA_TOKEN=your-long-lived-access-token

# Add your other API keys here
# SOME_OTHER_API_KEY=xxx